WIDTH = 32;
DEPTH = 32768;

ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
	BEGIN
		[0000..7FFF]: FFFFFFFF;
		0	:34000000; --NOOP
		1	:40100001; --LDR R1 #1
		2	:40400010; --LDR R4 #16
		3	:43440001; --SUBV R4 R4 #1
		4	:5C400000; --PRESENT R4 #0
		5	:F8110000; --ADD R1 R1 R1
		6	:40000000; --LDR R0 #0
		7	:FA000000; --SSOP R0
		8	:4020FFFF; --LDR R2 #65535
		9	:43220001; --SUBV R2 R2 #1
		A	:5C200003; --PRESENT R2 #3
		B	:58000009; --JMP #9
	END;
