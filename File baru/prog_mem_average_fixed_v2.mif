WIDTH=32;
DEPTH=256;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
    00 : 34000000;  -- LDR R6, #0       ; sum = 0
    01 : 34180000;  -- LDR R7, #0       ; count = 0
    02 : 43000008;  -- LDR R1, #8       ; load limit once
    03 : 58000003;  -- LSIP R2          ; read ADC
    04 : 50183000;  -- ADD R6, R6, R2   ; sum += sample
    05 : 501C3001;  -- ADD R7, R7, #1   ; count++
    06 : 50102001;  -- SUB R1, R1, R7   ; limit -= count
    07 : 62040000;  -- SZ               ; Z = (limit==0)
    08 : 67183000;  -- JNZ $0003        ; jump if NOT zero to loop
    09 : 40100006;  -- MOV R0, R6       ; move sum to R0
    0A : 43100003;  -- SHRA R0, #3      ; divide by 8
    0B : 08004000;  -- STR R0, #$4000 (opcode 000010 = STR)
    0C : F8000000;  -- JMP $0000        ; idle loop
    [0D..FF] : 34000000; -- NOOP padding
END;